<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="FluentAssertions" Version="6.12.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="8.0.16" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.3" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <!-- Pulls the PP-OCRv5 models into the test output so the self-hosted OCR test
         can run the real engine (transitive PackageCopyToOutput doesn't reach here). -->
    <PackageReference Include="RapidOcrNet" Version="2.0.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared test gating attributes ([EnvironmentGatedFact], [LocalPostgresRequiredFact]).
         Linked, not duplicated, so there is exactly ONE copy to keep correct — hand-copied test
         infrastructure is how the bare-early-return idiom spread across three projects. -->
    <Compile Include="..\ProcuLink.TestSupport\*.cs" Link="TestSupport\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ProcuLink.Infrastructure\ProcuLink.Infrastructure.csproj" />
    <ProjectReference Include="..\ProcuLink.Core\ProcuLink.Core.csproj" />
    <!-- Task 9 (credential-AAD-binding): FailClosedCredentialSiteTests.cs needs EmailPollOrgJob,
         which lives in ProcuLink.Worker (not Infrastructure). Non-circular: Worker references
         Core/Infrastructure/Transform/Api, none of which reference this test project. -->
    <ProjectReference Include="..\ProcuLink.Worker\ProcuLink.Worker.csproj" />
  </ItemGroup>

</Project>
