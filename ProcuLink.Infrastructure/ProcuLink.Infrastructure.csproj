<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- PDFtoImage's Conversion APIs carry [SupportedOSPlatform] attributes; this is a
         Linux/Windows server app, so the platform-compat analyzer (CA1416) is noise. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" Version="4.0.23.3" />
    <PackageReference Include="FluentFTP" Version="54.2.0" />
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="8.0.11" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.16" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.16" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.11" />
    <PackageReference Include="OpenAI" Version="2.10.0" />
    <!-- PDF rasterization for the vision fallback (scanned/no-text PDFs). PDFtoImage (MIT)
         bundles PDFium (BSD-3) + SkiaSharp.NativeAssets.Linux.NoDependencies (self-contained,
         no apt/fontconfig needed) — verified loading on the Debian aspnet:8.0 base image. -->
    <PackageReference Include="PDFtoImage" Version="5.2.1" />
    <!-- Self-hosted, no-egress OCR (Phase 3): RapidOcrNet (Apache-2.0) runs PP-OCRv5
         via ONNX Runtime. Bundles ~12MB models. Native deps on the Debian base:
         libgomp1 (ONNX) + libfontconfig1 (its SkiaSharp) — added to both Dockerfiles
         (Docker-verified; see docs/verification/native-deps.md). -->
    <PackageReference Include="RapidOcrNet" Version="2.0.0" />
    <PackageReference Include="PostHog" Version="2.7.1" />
    <!-- 2026.0.0 is the FIRST version clearing GHSA-q939-rpr3-3284 / CVE-2026-48798 (HIGH,
         CVSS 7.1): a path traversal in ScpClient.Download()'s recursive mode, where a hostile
         server returns "../" names and the client writes outside the target directory. Every
         version <= 2025.1.0 is affected, so there is no smaller bump. This repo uses SftpClient
         only — grep for ScpClient returns nothing — so the flaw was never reachable here; the
         upgrade exists to clear the NU1903 audit warning that was riding on every restore. -->
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <PackageReference Include="Hangfire.Core" Version="1.8.18" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ProcuLink.Core\ProcuLink.Core.csproj" />
    <ProjectReference Include="..\ProcuLink.Transform\ProcuLink.Transform.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Linked embed so SampleOrderService can load the sample fixture from its own assembly
         without taking a project reference on ProcuLink.Api (which would create a dependency cycle).
         The same file is also embedded in ProcuLink.Api for symmetry with other Api fixtures. -->
    <!-- FORWARD SLASHES are mandatory: on Linux (the Railway Docker build) a backslash is a
         legal filename char, so MSBuild treats "..\ProcuLink.Api\..." as ONE literal filename,
         fails to find it, and silently does NOT embed the resource — then GetManifestResourceStream
         returns null at runtime and POST /api/onboarding/sample-order throws an unhandled 500. -->
    <EmbeddedResource Include="../ProcuLink.Api/Fixtures/sample-order.csv" Link="Fixtures/sample-order.csv" LogicalName="ProcuLink.Infrastructure.Fixtures.sample-order.csv" />
  </ItemGroup>

  <ItemGroup>
    <!-- Allow internal test-only ctors to be reachable from Infrastructure.Tests. -->
    <InternalsVisibleTo Include="ProcuLink.Infrastructure.Tests" />
    <!-- Api.Tests' real-Postgres delivery integration tests seed rows carrying the deterministic
         idempotency key: they must call DeliveryService.BuildIdempotencyKey directly rather than
         re-deriving its string format, or the two are free to drift apart undetected. -->
    <InternalsVisibleTo Include="ProcuLink.Api.Tests" />
  </ItemGroup>

</Project>
