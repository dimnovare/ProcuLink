<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" Version="4.0.23.3" />
    <PackageReference Include="FluentFTP" Version="54.2.0" />
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="8.0.11" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.16" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.16" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.11" />
    <PackageReference Include="OpenAI" Version="2.10.0" />
    <PackageReference Include="PostHog" Version="2.7.1" />
    <PackageReference Include="SSH.NET" Version="2024.2.0" />
    <PackageReference Include="Hangfire.Core" Version="1.8.18" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ProcuLink.Core\ProcuLink.Core.csproj" />
    <ProjectReference Include="..\ProcuLink.Transform\ProcuLink.Transform.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Linked embed so SampleOrderService can load the sample fixture from its own assembly
         without taking a project reference on ProcuLink.Api (which would create a dependency cycle).
         The same file is also embedded in ProcuLink.Api for symmetry with other Api fixtures. -->
    <EmbeddedResource Include="..\ProcuLink.Api\Fixtures\sample-order.csv" Link="Fixtures\sample-order.csv" LogicalName="ProcuLink.Infrastructure.Fixtures.sample-order.csv" />
  </ItemGroup>

  <ItemGroup>
    <!-- Allow internal test-only ctors to be reachable from Infrastructure.Tests. -->
    <InternalsVisibleTo Include="ProcuLink.Infrastructure.Tests" />
  </ItemGroup>

</Project>
