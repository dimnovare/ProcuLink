<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="FluentAssertions" Version="6.12.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="SharpCompress" Version="0.49.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ProcuLink.Transform\ProcuLink.Transform.csproj" />
    <ProjectReference Include="..\ProcuLink.Core\ProcuLink.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- Real-distributor catalog fixtures (plan 2026-07-02), trimmed + de-identified.
         "De-identified" is enforced, not asserted, in two directions:
           • CONTENTS — Architecture\FixtureDeIdentificationGuardTests sweeps every tracked fixture
             in the repository and fails on an email address outside the RFC 2606 / RFC 6761
             reserved names, an absolute local filesystem path, a file:// URI, a URL or hostname
             on a host that is neither reserved-for-documentation nor an approved standards host,
             or an Ariba Network ID outside the reserved all-zeros placeholder range. The host
             rule is an allow-list for the same reason the naming vocabulary is: a deny-list of
             real domains would republish, in the current tree, exactly what it suppresses.
           • NAMES — Architecture\FixtureNamingGuardTests sweeps the same corpus's PATHS and fails
             on any directory or file-name token outside the approved format/dialect/shape
             vocabulary. This repository is public, so a file name is as readable as its contents. -->
    <None Include="Catalog\Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="FormatMatrix\RealWorldFixtures\*.xml" />
  </ItemGroup>

</Project>
