<?xml version="1.0" encoding="utf-8"?>
<!--
  Project-level NuGet config.

  Purpose: guarantee nuget.org is available in every build environment,
  including fresh CI runners, ephemeral background agents, and contributor
  machines that may not have a user-level NuGet.Config.

  Added because SSH.NET 2024.2.0 (Infrastructure dependency) is not indexed
  on the private Azure DevOps package feed that some local user-level configs
  use, so restore failed in environments where that feed was the only
  registered source.

  We intentionally do NOT <clear /> inherited sources. If a user/machine-level
  config defines an additional feed for private packages, it remains
  available; this file only ensures nuget.org is present on top. ProcuLink
  itself depends on zero private packages, so removing such a feed entirely
  would not break this repo — but preserving inheritance keeps the door open
  for future shared tooling.
-->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
