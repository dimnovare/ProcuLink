<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-ProcuLink.Worker-f6445e22-ba08-4ef0-ba1a-429882ba2bf8</UserSecretsId>
    <!-- Worker references ProcuLink.Api for ParseOrderJob; both have appsettings.json.
         Allow the last-written copy to win — Worker's appsettings overwrite the Api's. -->
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="CsvHelper" Version="33.0.0" />
    <PackageReference Include="Hangfire.PostgreSql" Version="1.20.10" />
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="Microsoft.AspNetCore.Http.Abstractions" Version="2.3.8" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <!-- Direct ref so RapidOcrNet's PP-OCRv5 models are copied into the Worker's
         publish output (transitive PackageCopyToOutput from Infrastructure doesn't
         flow). The Worker runs ParseOrderJob, where self-hosted OCR executes. -->
    <PackageReference Include="RapidOcrNet" Version="2.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ProcuLink.Core\ProcuLink.Core.csproj" />
    <ProjectReference Include="..\ProcuLink.Infrastructure\ProcuLink.Infrastructure.csproj" />
    <ProjectReference Include="..\ProcuLink.Transform\ProcuLink.Transform.csproj" />
    <ProjectReference Include="..\ProcuLink.Api\ProcuLink.Api.csproj" />
  </ItemGroup>
</Project>
