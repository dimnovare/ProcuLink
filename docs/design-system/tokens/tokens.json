{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "ProcuLink design tokens · v1.0 · The Bridge Layer",

  "color": {
    "brand": {
      "blue":      { "$value": "#1E66C9", "$type": "color" },
      "blueDeep":  { "$value": "#0F4FA8", "$type": "color" },
      "blueSoft":  { "$value": "#E3EDFB", "$type": "color" },
      "green":     { "$value": "#2E8E3A", "$type": "color" },
      "greenDeep": { "$value": "#1E6D29", "$type": "color" },
      "greenSoft": { "$value": "#E2F1E2", "$type": "color" }
    },
    "navy": {
      "DEFAULT": { "$value": "#0B1A2F", "$type": "color" },
      "surface": { "$value": "#10243E", "$type": "color" },
      "border":  { "$value": "#1C2F49", "$type": "color" },
      "text":    { "$value": "#C5D2E4", "$type": "color" },
      "muted":   { "$value": "#7C8DA6", "$type": "color" }
    },
    "bg":        { "$value": "#F6F7FA", "$type": "color" },
    "bgWarm":    { "$value": "#F8F6F1", "$type": "color" },
    "surface":   { "$value": "#FFFFFF", "$type": "color" },
    "surface2":  { "$value": "#EFF2F7", "$type": "color" },
    "border":    { "$value": "#E2E6EE", "$type": "color" },
    "borderStrong": { "$value": "#C6CDDA", "$type": "color" },
    "ink":       { "$value": "#0B1A2F", "$type": "color" },
    "inkMuted":  { "$value": "#56627A", "$type": "color" },
    "inkFaint":  { "$value": "#8A93A5", "$type": "color" },
    "amber":     { "$value": "#C97A14", "$type": "color" },
    "amberSoft": { "$value": "#FAEFD6", "$type": "color" },
    "danger":    { "$value": "#C53A3A", "$type": "color" },
    "dangerSoft":{ "$value": "#FBE3E3", "$type": "color" },
    "ai":        { "$value": "#6F4FCE", "$type": "color" },
    "aiSoft":    { "$value": "#EEE7FB", "$type": "color" }
  },

  "font": {
    "sans":    { "$value": "Inter, system-ui, -apple-system, sans-serif", "$type": "fontFamily" },
    "display": { "$value": "Bricolage Grotesque, Inter, system-ui, sans-serif", "$type": "fontFamily" },
    "mono":    { "$value": "JetBrains Mono, ui-monospace, monospace", "$type": "fontFamily" }
  },

  "size": {
    "xs":        { "$value": "10px", "$type": "dimension" },
    "sm":        { "$value": "11.5px", "$type": "dimension" },
    "bodyS":     { "$value": "12.5px", "$type": "dimension" },
    "body":      { "$value": "13px", "$type": "dimension" },
    "bodyL":     { "$value": "14px", "$type": "dimension" },
    "h4":        { "$value": "16px", "$type": "dimension" },
    "h3":        { "$value": "18px", "$type": "dimension" },
    "h2":        { "$value": "24px", "$type": "dimension" },
    "h1":        { "$value": "32px", "$type": "dimension" },
    "displayS":  { "$value": "36px", "$type": "dimension" },
    "display":   { "$value": "48px", "$type": "dimension" },
    "displayL":  { "$value": "78px", "$type": "dimension" }
  },

  "space": {
    "1":  { "$value": "4px", "$type": "dimension" },
    "2":  { "$value": "8px", "$type": "dimension" },
    "3":  { "$value": "12px", "$type": "dimension" },
    "4":  { "$value": "16px", "$type": "dimension" },
    "5":  { "$value": "20px", "$type": "dimension" },
    "6":  { "$value": "24px", "$type": "dimension" },
    "8":  { "$value": "32px", "$type": "dimension" },
    "10": { "$value": "40px", "$type": "dimension" },
    "12": { "$value": "48px", "$type": "dimension" },
    "16": { "$value": "64px", "$type": "dimension" },
    "20": { "$value": "80px", "$type": "dimension" },
    "24": { "$value": "96px", "$type": "dimension" }
  },

  "radius": {
    "sm":   { "$value": "4px", "$type": "dimension" },
    "DEFAULT": { "$value": "6px", "$type": "dimension" },
    "md":   { "$value": "8px", "$type": "dimension" },
    "lg":   { "$value": "10px", "$type": "dimension" },
    "xl":   { "$value": "12px", "$type": "dimension" },
    "full": { "$value": "9999px", "$type": "dimension" }
  },

  "shadow": {
    "card": { "$value": "0 1px 2px rgba(11,26,47,0.04)",                                  "$type": "shadow" },
    "pop":  { "$value": "0 8px 24px rgba(11,26,47,0.10)",                                 "$type": "shadow" },
    "hero": { "$value": "0 50px 120px rgba(11,26,47,0.10), 0 8px 24px rgba(11,26,47,0.06)", "$type": "shadow" }
  },

  "motion": {
    "easeOut":         { "$value": "cubic-bezier(0.16, 1, 0.3, 1)",   "$type": "cubicBezier" },
    "easeInOut":       { "$value": "cubic-bezier(0.65, 0, 0.35, 1)", "$type": "cubicBezier" },
    "durationFast":    { "$value": "150ms",  "$type": "duration" },
    "duration":        { "$value": "250ms",  "$type": "duration" },
    "durationSlow":    { "$value": "400ms",  "$type": "duration" },
    "durationSpine":   { "$value": "1200ms", "$type": "duration" },
    "durationWireLoop":{ "$value": "6000ms", "$type": "duration" }
  }
}
