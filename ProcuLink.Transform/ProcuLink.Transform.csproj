<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ProcuLink.Core\ProcuLink.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Expose internal helpers (ScribanOrderModel, the shared sandbox builder) to the unit tests
         without widening the public API surface. -->
    <InternalsVisibleTo Include="ProcuLink.Transform.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Vendored OASIS UBL 2.1 Order schema + its complete import closure (14 files, ~2.8 MB), so
         UblSchemaValidator can validate emitted UBL against the STANDARD rather than against our own
         reading of it. Provenance, digests and the three licences are in the PROVENANCE.md embedded
         alongside them — the OASIS grant is conditioned on the notices travelling with the copy, and
         every notice lives inside the file it governs.

         EMBEDDED, not Content/CopyToOutputDirectory, on purpose: the schemas must resolve identically
         in a unit test, in the API container and in the Worker container, with no working-directory or
         publish-layout dependency. A validator that silently finds no schema is worse than one that
         cannot start.

         LogicalName is set explicitly rather than left to the default $(RootNamespace)-derived name.
         The directory is literally called "ubl-2.1", so the default mangling would bury a dot inside
         the resource name and the closure resolver — which maps "../common/X.xsd" onto a resource —
         would be parsing MSBuild's naming convention. These names are just the on-disk relative path. -->
    <EmbeddedResource Include="Conformance\Schemas\ubl-2.1\maindoc\*.xsd"
                      LogicalName="ubl-2.1/maindoc/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Conformance\Schemas\ubl-2.1\common\*.xsd"
                      LogicalName="ubl-2.1/common/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Conformance\Schemas\ubl-2.1\PROVENANCE.md"
                      LogicalName="ubl-2.1/PROVENANCE.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="CsvHelper" Version="33.0.0" />
    <!-- ILogger abstraction only (no concrete provider) so the static output builders can emit
         observability warnings for swallowed fail-open paths (corrupt totals, Scriban/SourceMap
         eval failures) via TransformDiagnostics. Defaults to NullLogger — silent + behaviour-
         unchanged — until the composition root assigns a factory. net8 servicing band to match
         the EF/ASP.NET 8.0.x packages the rest of the solution resolves transitively. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageReference Include="PdfPig" Version="0.1.14" />
    <!-- Sandboxed per-field expression templating for the flexible per-order mapping override
         (ScribanFieldEvaluator). Scriban is MIT-licensed (no commercial-licence concern) and is a
         pure string-template engine with no file/network/process surface. -->
    <PackageReference Include="Scriban" Version="7.2.4" />
    <PackageReference Include="SharpCompress" Version="0.49.1" />
    <!-- Legacy code pages (windows-1252, etc.) for distributor catalog feeds shipped in a
         non-UTF-8 encoding (e.g. a tab-delimited feed shipped as cp1252). MIT / Microsoft — no
         licence concern.
         Registered on demand by SupplierCatalogFileParser.ResolveEncoding. -->
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
  </ItemGroup>

</Project>
